<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd job that runs `celestia-rs-auto-update.sh watchdog` every
  minute (docs/operator-guide.md §8, "Restarting a node that fell
  behind"). It restarts a node that stays more than 50 blocks behind its
  reference RPC, so that it block-syncs instead of crawling back through
  consensus. Needs packaging/macos/celestia-rs.sudoers. Install:

    install -m 755 packaging/macos/celestia-rs-auto-update.sh packaging/check-apphash.sh ~/.celestia-rs/bin/
    sed -e "s|__USER__|$(id -un)|g" -e "s|__HOME__|$HOME|g" \
      packaging/macos/org.celestia.celestia-rs-watchdog.plist \
      | sudo tee /Library/LaunchDaemons/org.celestia.celestia-rs-watchdog.plist >/dev/null
    sudo launchctl bootstrap system /Library/LaunchDaemons/org.celestia.celestia-rs-watchdog.plist

  Pause:  sudo launchctl bootout system/org.celestia.celestia-rs-watchdog
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.celestia.celestia-rs-watchdog</string>

  <key>UserName</key>
  <string>__USER__</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.celestia-rs/bin/celestia-rs-auto-update.sh</string>
    <string>watchdog</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__HOME__/.celestia-rs</string>

  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>60</integer>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/celestia-rs-watchdog.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/celestia-rs-watchdog.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <!-- curl and jq. -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
