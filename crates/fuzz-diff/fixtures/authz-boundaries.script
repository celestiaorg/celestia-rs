# Signed authorization boundary and rollback regression.
# Accounts are the deterministic `fuzz-diff accounts` fixtures, never live keys.
# One signed transaction per block; all grants expire at 2100-01-01 UTC.
# The companion JSON requires every exact signed tx to finalize in order.
# Compare both authz-feegrant and v9-authz-feegrant against their pinned Go app.
# Unrestricted budget 20
0 /cosmos.authz.v1beta1.MsgGrant 
---
# Spend one below half the budget
1 /cosmos.authz.v1beta1.MsgExec 
---
# Exhaust the remaining budget exactly
1 /cosmos.authz.v1beta1.MsgExec 
---
# Exhaustion deleted the grant
1 /cosmos.authz.v1beta1.MsgExec 
---
# Allow-list budget 20, two recipients
0 /cosmos.authz.v1beta1.MsgGrant 
---
# First recipient accepted
1 /cosmos.authz.v1beta1.MsgExec 
---
# Last recipient accepted
1 /cosmos.authz.v1beta1.MsgExec 
---
# Subtraction precedes recipient filtering (11 > remaining 10)
1 /cosmos.authz.v1beta1.MsgExec 
---
# Missing recipient rejected within budget
1 /cosmos.authz.v1beta1.MsgExec 
---
# Allowed recipient still cannot exceed remaining budget by one
1 /cosmos.authz.v1beta1.MsgExec 
---
# Failed accepts preserved the exact remaining budget
1 /cosmos.authz.v1beta1.MsgExec 
---
# Exact consumption deleted the grant
1 /cosmos.authz.v1beta1.MsgExec 
---
# Same grant used twice inside one MsgExec
0 /cosmos.authz.v1beta1.MsgGrant 
---
# Both inner sends update the same grant in order
1 /cosmos.authz.v1beta1.MsgExec 
---
# Consume remaining 10 after both inner uses
1 /cosmos.authz.v1beta1.MsgExec 
---
# Grant absent after repeated-use exhaustion
1 /cosmos.authz.v1beta1.MsgExec 
---
# New budget for rollback test
0 /cosmos.authz.v1beta1.MsgGrant 
---
# Authorize nested delegate to reach its handler
0 /cosmos.authz.v1beta1.MsgGrant 
---
# Send succeeds before a later authorized staking handler fails
1 /cosmos.authz.v1beta1.MsgExec 
---
# Full original budget survives failed multi-message MsgExec
1 /cosmos.authz.v1beta1.MsgExec 
---
# Exact post-rollback consumption deleted grant
1 /cosmos.authz.v1beta1.MsgExec 
---
# Replacement starts at 20
0 /cosmos.authz.v1beta1.MsgGrant 
---
# Spend 5 before replacing authorization
1 /cosmos.authz.v1beta1.MsgExec 
---
# Replace same-expiration grant and budget with 30
0 /cosmos.authz.v1beta1.MsgGrant 
---
# One over the old remaining 15 succeeds on the replacement
1 /cosmos.authz.v1beta1.MsgExec 
---
# Exactly exhaust the replacement
1 /cosmos.authz.v1beta1.MsgExec 
---
# Replacement exhaustion deleted the grant
1 /cosmos.authz.v1beta1.MsgExec 
---
