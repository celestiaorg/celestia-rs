# Signed v9 StakeAuthorization boundary regression.
# Accounts and validator are deterministic local authz-feegrant fixtures.
# One signed transaction per block; grants expire at 2100-01-01 UTC.
# The companion JSON requires each exact signed tx and Go outcome in order.
# Allow-list grant with budget 20
0 /cosmos.authz.v1beta1.MsgGrant 
---
# Partial delegate updates budget to 15
1 /cosmos.authz.v1beta1.MsgExec 
---
# One over the remaining budget is rejected
1 /cosmos.authz.v1beta1.MsgExec 
---
# Failed accept preserved the exact remaining budget
1 /cosmos.authz.v1beta1.MsgExec 
---
# Exact exhaustion deleted the grant
1 /cosmos.authz.v1beta1.MsgExec 
---
# Allow-list scans a missing first entry
0 /cosmos.authz.v1beta1.MsgGrant 
---
# Last allow-list entry succeeds
1 /cosmos.authz.v1beta1.MsgExec 
---
# Last-entry grant exhausts exactly
1 /cosmos.authz.v1beta1.MsgExec 
---
# Allow-list has the validator first
0 /cosmos.authz.v1beta1.MsgGrant 
---
# First allow-list entry succeeds and exhausts
1 /cosmos.authz.v1beta1.MsgExec 
---
# Allow-list omits the validator
0 /cosmos.authz.v1beta1.MsgGrant 
---
# Missing allow-list validator is rejected
1 /cosmos.authz.v1beta1.MsgExec 
---
# Deny-list contains the validator
0 /cosmos.authz.v1beta1.MsgGrant 
---
# Deny-list hit is rejected
1 /cosmos.authz.v1beta1.MsgExec 
---
# Deny-list contains only another validator
0 /cosmos.authz.v1beta1.MsgGrant 
---
# Deny-list non-match succeeds
1 /cosmos.authz.v1beta1.MsgExec 
---
# Deny-list non-match exhausts exactly
1 /cosmos.authz.v1beta1.MsgExec 
---
# Nil max token grant
0 /cosmos.authz.v1beta1.MsgGrant 
---
# Nil max token grant accepts first delegate
1 /cosmos.authz.v1beta1.MsgExec 
---
# Nil max token grant remains after use
1 /cosmos.authz.v1beta1.MsgExec 
