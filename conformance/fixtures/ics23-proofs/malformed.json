{
  "scenario": "ics23-proofs-malformed",
  "source": "cosmossdk.io/store/types v1.1.1 malformed proof-op cases",
  "cases": [
    {
      "label": "malformed_proto",
      "api": "proof_decode",
      "data_hex": "ff",
      "expected_error": "malformed_proto"
    },
    {
      "label": "missing_commitment_variant",
      "api": "proof_decode",
      "expected_error": "malformed_proto"
    },
    {
      "label": "unknown_proof_op_type",
      "api": "op_decode",
      "proof_op_type": "unknown",
      "key_hex": "0a",
      "data_hex": "",
      "expected_error": "invalid_type"
    },
    {
      "label": "empty_proof_op_key",
      "api": "op_decode",
      "proof_op_type": "ics23:iavl",
      "data_hex": "",
      "expected_error": "empty_key"
    },
    {
      "label": "bad_run_arg_count",
      "api": "run",
      "proof_op_type": "ics23:iavl",
      "key_hex": "0a",
      "data_hex": "",
      "run_args_hex": [
        "0a",
        "6578747261"
      ],
      "expected_error": "invalid_proof"
    },
    {
      "label": "wrong_membership_value",
      "api": "run",
      "proof_op_type": "ics23:iavl",
      "key_hex": "0a",
      "data_hex": "",
      "run_args_hex": [
        "77726f6e67"
      ],
      "expected_error": "invalid_proof"
    },
    {
      "label": "wrong_membership_key",
      "api": "run",
      "proof_op_type": "ics23:iavl",
      "key_hex": "ff",
      "data_hex": "",
      "run_args_hex": [
        "0a"
      ],
      "expected_error": "invalid_proof"
    }
  ]
}
