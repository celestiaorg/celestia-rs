      "proof_key_hex": "62",
      "verify_key_hex": "62",
      "value_hex": "77726f6e67",
      "root_hash_hex": "171716f1defab796d9adfaecf0edcedcc98b9ef07d6770e8e3f06bcc09e7e000",
