# Future Git LFS patterns for large conformance fixtures (>10MB).
# Activate via: git lfs install && git lfs track "<pattern>"
# conformance/fixtures/**/*.bin.zst filter=lfs diff=lfs merge=lfs -text
* text=auto eol=lf
*.rs text diff=rust
*.go text diff=golang
# Frozen upstream output is byte-for-byte evidence and retains Go/TOML spacing.
conformance/grpc-limits/v10.5.0/app.toml whitespace=-blank-at-eol
conformance/grpc-limits/v10.5.0/go-build-info.txt whitespace=-blank-at-eol
